PORT=8787
HOST=127.0.0.1
TRUST_PROXY=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/launchbase
DATABASE_SSL=false
DATABASE_POOL_MAX=5
CLIENT_ORIGIN=http://localhost:5173
MALAYSIA_DATA_CACHE_DAYS=30
GEOCODE_CACHE_DAYS=180
MARKET_DATA_CACHE_HOURS=24
MARKET_STALE_MAX_DAYS=30
OVERPASS_TIMEOUT_MS=18000
OVERPASS_TOTAL_TIMEOUT_MS=32000
# Wide/dense scans use a node-first query from this radius to avoid public-provider overload.
OVERPASS_DENSE_SCAN_RADIUS_METERS=5000
MARKET_CACHE_COORDINATE_PRECISION=3
ANALYSIS_RESULT_CACHE_SECONDS=300
ANALYSIS_MEMORY_CACHE_MAX_ENTRIES=48
MEMORY_CACHE_MAX_ENTRIES=64
MAP_RESPONSE_BUSINESS_LIMIT=1000
ANALYSIS_RATE_WINDOW_MS=600000
ANALYSIS_RATE_LIMIT=30
OSM_USER_AGENT="LaunchBaseSearch/1.0 (replace-with-your-contact-email)"

# Optional private partner endpoint for consented, anonymised store outcomes.
# Generate a long random value and never expose it through VITE_ variables.
OUTCOME_INGEST_TOKEN=

# Browser-restricted key with only Maps Embed API enabled.
VITE_GOOGLE_MAPS_EMBED_API_KEY=

# Contact form. VITE_CONTACT_EMAIL is display-only; SMTP secrets stay server-side.
VITE_CONTACT_EMAIL=hello@laubase.xyz
CONTACT_TO_EMAIL=your-destination-inbox@gmail.com
# For Gmail SMTP, use smtp.gmail.com, port 465, secure=true, and a Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
CONTACT_FROM_EMAIL=
CONTACT_RATE_WINDOW_MS=900000
CONTACT_RATE_LIMIT=5

# Optional Google AdSense integration. Keep these empty during local development.
# Use your approved ca-pub client ID and numeric slot IDs created in AdSense.
VITE_GOOGLE_ADSENSE_CLIENT=
VITE_GOOGLE_ADSENSE_SLOT_LANDING=
VITE_GOOGLE_ADSENSE_SLOT_ANALYSIS=
